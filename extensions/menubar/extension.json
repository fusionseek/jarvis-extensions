{
  "manifestVersion": 2,
  "id": "menubar",
  "version": "1.1.0",
  "name": "菜单栏管理",
  "symbol": "menubar.rectangle",
  "description": "把用不着的菜单栏图标收起来：点一下「‹」、点菜单栏空白处、悬停或在上面滚动就露出来，指针离开一会儿自己收回；也可以不动菜单栏，在「‹」下面弹一条副栏，点副栏里的图标就替你点开它。被刘海挡住的放进副栏。菜单栏没变时 Jarvis 不去读它，空闲不占 CPU。",
  "author": {
    "name": "fusionseek",
    "github": "fusionseek"
  },
  "main": "dist/extension.js",
  "sdk": "^2.12.0",
  "minimumJarvisVersion": "3.3.1",
  "capabilities": [
    {
      "id": "menuBar.pointer",
      "reason": "悬停、点菜单栏空白处或在上面滚动时露出隐藏的图标；只知道菜单栏那一条上的事"
    },
    {
      "id": "menuBarExtras.read",
      "reason": "在工具箱页与副栏里列出每一段里有哪些图标、哪些被刘海挡住"
    },
    {
      "id": "menuBarExtras.capture",
      "reason": "副栏与工具箱页里画出图标的真实样子；只在图标露着时截那几颗，不给就画应用图标"
    },
    {
      "id": "menuBarExtras.control",
      "reason": "点副栏里的一颗时，先把它露出来再替你点开；菜单关上就收回"
    }
  ],
  "contributes": {
    "toolbox": {
      "subtitle": "收起不常用的菜单栏图标",
      "keywords": [
        "menubar",
        "menu bar",
        "bartender",
        "hidden bar",
        "notch",
        "刘海",
        "状态栏"
      ]
    },
    "menuBar": {
      "title": "菜单栏管理",
      "symbol": "chevron.left",
      "preferences": [
        "clickReveal",
        "hoverReveal",
        "scrollReveal",
        "autoRehide",
        "alwaysHidden"
      ],
      "items": [
        {
          "id": "toggle",
          "title": "显示或收起隐藏的图标",
          "symbol": "chevron.left",
          "placement": "trailing"
        },
        {
          "id": "hidden",
          "title": "隐藏段的分隔竖线",
          "symbol": "poweron",
          "placement": "trailing"
        },
        {
          "id": "always",
          "title": "永远隐藏段的分隔竖线",
          "symbol": "poweron"
        }
      ]
    },
    "commands": [
      {
        "id": "toggle",
        "title": "显示或收起菜单栏图标",
        "description": "在露出隐藏的图标与收起之间切换，与点菜单栏上的「‹」相同",
        "slash": {
          "keyword": "menubar",
          "aliases": [
            "菜单栏"
          ]
        },
        "presentation": "silent"
      },
      {
        "id": "bar",
        "title": "副栏",
        "description": "在「‹」下面弹一条副栏，画藏起来的与被刘海挡住的图标",
        "presentation": "popover",
        "popoverWidth": "content"
      },
      {
        "id": "reveal-item",
        "title": "点开图标",
        "description": "露出一颗藏起来的图标并点开它（副栏里点一颗时用）",
        "presentation": "silent"
      }
    ],
    "settings": {
      "preferences": [
        {
          "key": "showIn",
          "type": "select",
          "title": "隐藏的图标显示在",
          "description": "在菜单栏里展开，或者菜单栏不动、在「‹」下面弹一条副栏",
          "default": "menuBar",
          "options": [
            {
              "value": "menuBar",
              "title": "菜单栏里"
            },
            {
              "value": "bar",
              "title": "副栏"
            }
          ]
        },
        {
          "key": "clickReveal",
          "type": "toggle",
          "title": "点菜单栏空白处显示",
          "description": "点菜单栏上没有图标、也不是菜单标题的地方，露出或收起隐藏的图标",
          "default": true
        },
        {
          "key": "hoverReveal",
          "type": "toggle",
          "title": "指针停在菜单栏上时显示",
          "description": "要一直留意指针的移动，比别的方式多一点点开销；默认关",
          "default": false
        },
        {
          "key": "scrollReveal",
          "type": "toggle",
          "title": "在菜单栏上滚动显示或收起",
          "description": "向上滚露出，向下滚收起",
          "default": false
        },
        {
          "key": "autoRehide",
          "type": "number",
          "title": "自动收回（秒）",
          "description": "指针离开菜单栏多少秒后收回；点过某个图标时至少等 20 秒。0 = 不自动收回",
          "default": 10,
          "minimum": 0,
          "maximum": 120
        },
        {
          "key": "alwaysHidden",
          "type": "toggle",
          "title": "启用「永远隐藏」段",
          "description": "最左边那条竖线左边的图标只有 ⌥ 点「‹」时才出来",
          "default": true
        },
        {
          "key": "notchToBar",
          "type": "toggle",
          "title": "被刘海挡住的放进副栏",
          "description": "在菜单栏里展开时，挡在刘海下面、挤到刘海左边看不见的图标在「‹」下面的副栏里点得到",
          "default": true
        }
      ]
    }
  },
  "inbox": false
}
