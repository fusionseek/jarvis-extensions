{
  "manifestVersion": 2,
  "id": "send-to-phone",
  "version": "2.0.8",
  "name": "发到手机",
  "symbol": "iphone.and.arrow.forward",
  "description": "读一次剪贴板，经 Jarvis 快传把文字或链接推到已配对的手机上；快传没开时给一颗按钮替你打开，发完在 Inbox 留一条消息。/phone 后面跟一段字，不开面板直接发。",
  "author": {
    "name": "fusionseek",
    "github": "fusionseek"
  },
  "main": "dist/extension.js",
  "sdk": "^2.0.0",
  "minimumJarvisVersion": "3.0.3",
  "capabilities": [
    { "id": "clipboard.read", "reason": "读取要发送的文字或链接" },
    { "id": "quickTransfer.status", "reason": "知道快传开没开、有没有手机连着" },
    { "id": "quickTransfer.control", "reason": "快传没开时，你按了按钮才替你打开" },
    { "id": "quickTransfer.send", "reason": "把内容推到手机" },
    { "id": "inbox.post", "reason": "发完（或没发出去）在 Inbox 留一条消息" }
  ],
  "contributes": {
    "toolbox": {
      "subtitle": "把剪贴板里的东西推到手机",
      "keywords": ["phone", "push", "快传"]
    },
    "commands": [
      {
        "id": "send-text",
        "title": "发到手机",
        "description": "把 / 后面那段字推到手机，不开面板；没跟字就发剪贴板",
        "slash": { "keyword": "phone", "aliases": ["发到手机"], "argument": "要发送的文字" },
        "presentation": "silent"
      }
    ],
    "settings": {
      "preferences": [
        { "key": "trimWhitespace", "type": "toggle", "title": "去掉首尾空白", "default": true },
        { "key": "confirmBeforeSend", "type": "toggle", "title": "发送前确认", "description": "点「发到手机」后先看一眼再发", "default": false }
      ]
    }
  },
  "inbox": { "messages": true, "notifications": false }
}
