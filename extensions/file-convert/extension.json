      {
        "id": "install-ffmpeg",
        "title": "安装或修复 FFmpeg",
        "script": [
          "# Generated by Jarvis to install or repair ffmpeg for the file-convert extension. Safe to delete.",
          "export PATH=\"/opt/homebrew/bin:/usr/local/bin:$PATH\"",
          "printf '\\n=== Jarvis · 安装或修复 FFmpeg（「文件转换」用它转更多格式）===\\n\\n'",
          "if command -v brew >/dev/null 2>&1; then",
          "    if brew list --formula ffmpeg >/dev/null 2>&1; then",
          "        printf '已经装过，用 Homebrew 更新到最新版（它依赖的库被升级换掉、起不来时，更新它就会重新链上）：\\n  $ %s\\n\\n' 'brew upgrade ffmpeg'",
          "        brew upgrade ffmpeg",
          "        status=$?",
          "    else",
          "        printf '用 Homebrew 安装：\\n  $ %s\\n\\n' 'brew install ffmpeg'",
          "        brew install ffmpeg",
          "        status=$?",
          "    fi",
          "else",
          "    printf '这台 Mac 上没有 Homebrew（brew 命令），没法替你装。先装 Homebrew（会要管理员密码），在终端里运行：\\n     %s\\n装好之后回到 Jarvis「设置 · 文件」，再点一次「在终端中安装」。\\n' '/bin/bash -c \"$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\"'",
          "    status=1",
          "fi",
          "printf '\\n'",
          "if [ \"$status\" -eq 0 ]; then",
          "    printf '已装好：%s\\n回到 Jarvis，「设置 · 文件」里这一行会自己变成「已就绪」。\\n' \"$(command -v ffmpeg)\"",
          "else",
          "    printf '没有装上（退出码 %s）。上面是原始输出。\\n' \"$status\"",
          "fi",
          "printf '\\n按回车关闭。'",
          "read -r _",
          "exit \"$status\""
        ]
      },
