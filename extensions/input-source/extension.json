{
  "manifestVersion": 2,
  "id": "input-source",
  "version": "1.0.0",
  "name": "输入法切换",
  "symbol": "keyboard",
  "description": "切到哪个应用，就自动换成你给它定的输入法：写代码的地方用 ABC，聊天的地方用拼音。没写规则的应用可以不动、记住上次用的，或者换成默认输入法。规则在菜单栏图标里给此刻的应用选一下就定了；换过去的那一下，在文字光标旁闪一枚小牌子告诉你换成了什么。只在切换应用的那一刻做事，空闲不占 CPU。",
  "author": {
    "name": "fusionseek",
    "github": "fusionseek"
  },
  "main": "dist/extension.js",
  "sdk": "^2.13.0",
  "minimumJarvisVersion": "3.3.2",
  "capabilities": [
    {
      "id": "system.activity",
      "reason": "切到另一个应用的那一刻，按它的规则换输入法；只知道是哪个应用，不知道你在里面做什么"
    },
    {
      "id": "inputSources.read",
      "reason": "列出你启用的输入法，知道此刻用的是哪一个，记住你在每个应用里手动换过的那一个"
    },
    {
      "id": "inputSources.select",
      "reason": "按规则换到那个输入法"
    },
    {
      "id": "hud.show",
      "reason": "换过去的那一下，在文字光标旁闪一枚小牌子告诉你换成了什么"
    },
    {
      "id": "apps.read",
      "reason": "自己加规则时列出你装的应用、配上图标；第一次用时按应用分类推荐几条"
    }
  ],
  "contributes": {
    "toolbox": {
      "subtitle": "按应用自动切换输入法",
      "keywords": [
        "input source",
        "input method",
        "keyboard",
        "ime",
        "输入源",
        "中英文"
      ]
    },
    "menuBar": {
      "title": "输入法切换",
      "symbol": "keyboard",
      "preferences": [
        "menuBarLabel"
      ]
    },
    "commands": [
      {
        "id": "previous",
        "title": "切回上一个输入法",
        "description": "在此刻与上一个输入法之间来回切",
        "presentation": "silent"
      },
      {
        "id": "remember-here",
        "title": "把此刻输入法定给当前应用",
        "description": "以后切到这个应用就换成它",
        "slash": {
          "keyword": "input-source",
          "aliases": [
            "输入法"
          ]
        },
        "presentation": "silent"
      },
      {
        "id": "pause",
        "title": "暂停或恢复自动切换",
        "description": "暂停期间只记下你在各个应用里用的输入法，不替你切",
        "presentation": "silent"
      }
    ],
    "settings": {
      "preferences": [
        {
          "key": "others",
          "type": "select",
          "title": "没写规则的应用",
          "description": "切到一个还没定规则的应用时怎么办",
          "default": "keep",
          "options": [
            {
              "value": "keep",
              "title": "不动"
            },
            {
              "value": "remember",
              "title": "记住上次用的"
            },
            {
              "value": "default",
              "title": "换成默认输入法"
            }
          ]
        },
        {
          "key": "hud",
          "type": "toggle",
          "title": "切换时提示",
          "description": "替你换了输入法时，在文字光标旁闪一下换成了什么",
          "default": true
        },
        {
          "key": "hudAnchor",
          "type": "select",
          "title": "提示的位置",
          "description": "读不到文字光标的应用（终端、部分网页）一律在指针旁边",
          "default": "caret",
          "options": [
            {
              "value": "caret",
              "title": "文字光标下方"
            },
            {
              "value": "pointer",
              "title": "指针旁边"
            },
            {
              "value": "screen",
              "title": "屏幕下方"
            }
          ]
        },
        {
          "key": "hudOnManual",
          "type": "toggle",
          "title": "手动切换时也提示",
          "description": "你自己按快捷键换输入法时也闪一下",
          "default": false
        },
        {
          "key": "menuBarLabel",
          "type": "toggle",
          "title": "菜单栏图标旁显示当前输入法",
          "description": "「中」「A」「あ」这样的一个字",
          "default": true
        },
        {
          "key": "paused",
          "type": "toggle",
          "title": "暂停自动切换",
          "description": "暂停期间只记下你在各个应用里用的输入法，不替你切",
          "default": false
        }
      ]
    }
  },
  "inbox": false
}
