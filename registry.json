                },
                {
                  "key": "prettier",
                  "type": "text",
                  "title": "prettier 命令",
                  "description": "Markdown、JS / TS、JSON、YAML、CSS、HTML、Vue",
                  "default": "prettier",
                  "placeholder": "prettier",
                  "monospaced": true
                }
              ]
