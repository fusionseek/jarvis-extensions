      "manifest": {
        "manifestVersion": 2,
        "id": "code-format",
        "version": "1.0.0",
        "name": "代码格式化",
        "symbol": "wand.and.stars",
        "description": "给 Jarvis 的 Git 加上「格式化」：文件 diff 页里工作区那一份源码，按语言交给你装好的格式化工具——clang-format、swift-format、ktfmt、google-java-format、ruff、shfmt、prettier 等，先看对比，点「写入文件」才改。",
        "author": {
          "name": "fusionseek",
          "github": "fusionseek"
        },
        "main": "dist/extension.js",
        "sdk": "^2.7.0",
        "minimumJarvisVersion": "3.2.3",
        "capabilities": [
          {
            "id": "process.run",
            "reason": "调用你装好的格式化工具，把要格式化的源码经标准输入交给它"
          }
        ],
        "process": {
          "executables": [
            {
              "name": "clang-format",
              "arguments": [
                [
                  "--style=file",
                  "--assume-filename=jarvis-format.c"
                ],
                [
                  "--style=file",
                  "--assume-filename=jarvis-format.cpp"
                ],
                [
                  "--style=file",
                  "--assume-filename=jarvis-format.m"
                ],
                [
                  "--style=file",
                  "--assume-filename=jarvis-format.java"
                ],
                [
                  "--style=file",
                  "--assume-filename=jarvis-format.cs"
                ]
              ],
              "stdin": true
            },
            {
              "name": "swift-format",
              "arguments": [
                [
                  "format",
                  "--assume-filename",
                  "jarvis-format.swift",
                  "-"
                ]
              ],
              "stdin": true
            },
            {
              "name": "xcrun",
              "arguments": [
                [
                  "swift-format",
                  "format",
                  "--assume-filename",
                  "jarvis-format.swift",
                  "-"
                ],
                [
                  "--find",
                  "swift-format"
                ]
              ],
              "stdin": true
            },
            {
              "name": "ktfmt",
              "arguments": [
                [
                  "--kotlinlang-style",
                  "-"
                ]
              ],
              "stdin": true
            },
            {
              "name": "google-java-format",
              "arguments": [
                [
                  "-"
                ],
                [
                  "--aosp",
                  "-"
                ]
              ],
              "stdin": true
            },
            {
              "name": "csharpier",
              "arguments": [
                [
                  "format",
                  "--write-stdout"
                ]
              ],
              "stdin": true
            },
            {
              "name": "ruff",
              "arguments": [
                [
                  "format",
                  "--stdin-filename",
                  "jarvis-format.py",
                  "-"
                ]
              ],
              "stdin": true
            },
            {
              "name": "black",
              "arguments": [
                [
                  "-q",
                  "--stdin-filename",
                  "jarvis-format.py",
                  "-"
                ]
              ],
              "stdin": true
            },
            {
              "name": "shfmt",
              "arguments": [
                [
                  "--filename=jarvis-format.sh"
                ]
              ],
              "stdin": true
            },
            {
              "name": "prettier",
              "arguments": [
                [
                  "--stdin-filepath",
                  "jarvis-format.md"
                ],
                [
                  "--stdin-filepath",
                  "jarvis-format.mdx"
                ],
                [
                  "--stdin-filepath",
                  "jarvis-format.js"
                ],
                [
                  "--stdin-filepath",
                  "jarvis-format.jsx"
                ],
                [
                  "--stdin-filepath",
                  "jarvis-format.ts"
                ],
                [
                  "--stdin-filepath",
                  "jarvis-format.tsx"
                ],
                [
                  "--stdin-filepath",
                  "jarvis-format.json"
                ],
                [
                  "--stdin-filepath",
                  "jarvis-format.yaml"
                ],
                [
                  "--stdin-filepath",
                  "jarvis-format.css"
                ],
                [
                  "--stdin-filepath",
                  "jarvis-format.scss"
                ],
                [
                  "--stdin-filepath",
                  "jarvis-format.less"
                ],
                [
                  "--stdin-filepath",
                  "jarvis-format.html"
                ],
                [
                  "--stdin-filepath",
                  "jarvis-format.vue"
                ]
              ],
              "stdin": true
            },
            {
              "name": "gofmt",
              "arguments": [
                []
              ],
              "stdin": true
            },
            {
              "name": "rustfmt",
              "arguments": [
                [
                  "--edition",
                  "2021"
                ]
              ],
              "stdin": true
            },
            {
              "name": "xmllint",
              "arguments": [
                [
                  "--format",
                  "-"
                ]
              ],
              "stdin": true
            }
          ]
        },
        "contributes": {
          "services": [
            {
              "point": "code.format",
              "id": "formatters",
              "title": "代码格式化",
              "subtitle": "用你装好的格式化工具整理工作区的源码：C 系、Java、Kotlin、Swift、C#、Python、Shell、Markdown 与前端",
              "notes": [
                "只跑你自己装好的工具，扩展不带任何一种语言的格式化规则；找不到时告诉你怎么装",
                "工具在文件所在的目录里跑，认得那里的 .clang-format、.editorconfig、pyproject.toml、.prettierrc",
