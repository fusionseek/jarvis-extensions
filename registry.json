      "manifest": {
        "manifestVersion": 2,
        "id": "http-status",
        "version": "1.0.0",
        "name": "HTTP 状态码",
        "symbol": "number.circle",
        "description": "输入状态码或关键词，给出这个码的读法、语义、常见成因、怎么处理、相关的码与 RFC 出处。/http 404 或 ⌥⌘/（从剪贴板里抓码）的结果贴着指针原地弹出；也能在工作区窗口里开一枚标签。62 个标准码与 12 个常见非标准码都编在扩展里，不联网。",
        "author": {
          "name": "fusionseek",
          "github": "fusionseek"
        },
        "main": "dist/extension.js",
        "sdk": "^2.0.0",
        "minimumJarvisVersion": "3.0.3",
        "capabilities": [
          {
            "id": "clipboard.read",
            "reason": "⌥⌘/ 按下时读一次剪贴板，从里面找状态码"
          },
          {
            "id": "system.openURL",
            "reason": "点「打开原文」时用默认浏览器打开 RFC / MDN"
          },
          {
            "id": "hotkeys.register",
            "reason": "两条命令的全局快捷键"
          }
        ],
        "contributes": {
          "toolbox": {
            "subtitle": "查一个码：含义、成因、怎么处理",
            "keywords": [
              "status",
              "code",
              "rfc",
              "nginx",
              "cloudflare",
              "接口调试"
            ]
          },
          "window": {
            "subtitle": "在窗口里查状态码：含义、成因、怎么处理、出处",
            "keywords": [
              "status",
              "code",
              "rfc",
              "nginx",
              "cloudflare",
              "接口调试"
            ]
          },
          "commands": [
            {
              "id": "lookup",
              "title": "查状态码",
              "description": "打开面板，落在这个扩展的页面上",
              "hotkey": "⌥⌘H",
              "presentation": "toolbox"
            },
            {
              "id": "explain-clipboard",
              "title": "解释剪贴板里的码",
              "description": "读一次剪贴板，抓出状态码，结果贴着指针弹出",
              "hotkey": "⌥⌘/",
              "presentation": "popover"
            },
            {
              "id": "explain",
              "title": "解释状态码",
              "description": "查 / 后面那个码或关键词，结果贴着指针弹出",
              "slash": {
                "keyword": "http",
                "aliases": [
                  "状态码"
                ],
                "argument": "状态码或关键词"
              },
              "presentation": "popover"
            }
          ],
          "settings": {
            "preferences": [
              {
                "key": "copyFormat",
                "type": "select",
                "title": "复制格式",
                "description": "复制钮与弹窗里那颗 chip 写进剪贴板的形状",
                "default": "name",
                "options": [
                  {
                    "value": "code",
                    "title": "404"
                  },
                  {
                    "value": "name",
                    "title": "404 Not Found"
                  },
                  {
                    "value": "line",
                    "title": "整行含协议"
                  }
                ]
              },
              {
                "key": "specSource",
                "type": "select",
                "title": "出处打开哪一边",
                "description": "点「打开原文」时去 rfc-editor.org，还是 MDN 的中文页",
                "default": "rfc",
                "options": [
                  {
                    "value": "rfc",
                    "title": "RFC 原文"
