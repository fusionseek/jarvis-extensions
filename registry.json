    {
      "manifest": {
        "manifestVersion": 2,
        "id": "mole-clean",
        "version": "1.0.6",
        "name": "Mole 深度清理",
        "symbol": "bubbles.and.sparkles",
        "description": "给 Jarvis 清理换一台更深的引擎：开着时，晃球、/clean 与工具箱清理改走你装好的 Mole（mo clean），覆盖浏览器、开发工具、云盘、已卸载应用残留等更多类别，并读 Mole 的操作日志逐项显示正在删什么。没装 mo 时可以一键在终端里安装。",
        "author": {
          "name": "fusionseek",
          "github": "fusionseek"
        },
        "main": "dist/extension.js",
        "sdk": "^2.0.0",
        "minimumJarvisVersion": "3.0.3",
        "capabilities": [
          {
            "id": "process.run",
            "reason": "调用你装好的 mo clean 与 mo --version，它继承 Jarvis 的完全磁盘访问"
          },
          {
            "id": "files.read",
            "reason": "读 Mole 的操作日志，逐项显示正在删什么"
          },
          {
            "id": "terminal.run",
            "reason": "没装 mo 时在终端里替你安装"
          }
        ],
        "process": {
          "executables": [
            {
              "name": "mo",
              "arguments": [
                [
                  "clean"
                ],
                [
                  "--version"
                ]
              ]
            }
          ],
          "terminal": [
            {
              "id": "install",
              "title": "安装 Mole",
              "script": [
                "# Generated by Jarvis to install Mole (https://github.com/tw93/mole). Safe to delete.",
                "export PATH=\"/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH\"",
                "printf '\\n=== Jarvis · 安装 Mole（深度清理用的 mo 命令）===\\n\\n'",
                "if command -v brew >/dev/null 2>&1; then",
                "    printf '用 Homebrew 安装：\\n  $ %s\\n\\n' 'brew install mole'",
                "    brew install mole",
                "    status=$?",
                "else",
                "    printf 'PATH 里没有 brew，改用 Mole 官方安装脚本，装到 %s（不需要管理员密码）：\\n  $ %s\\n\\n' '~/.local/bin' 'curl -fsSL https://raw.githubusercontent.com/tw93/mole/main/install.sh | bash -s -- --prefix ~/.local/bin'",
                "    mkdir -p \"$HOME/.local/bin\"",
                "    dir=$(mktemp -d)",
                "    if curl -fsSL --connect-timeout 15 --max-time 120 'https://raw.githubusercontent.com/tw93/mole/main/install.sh' -o \"$dir/install.sh\"; then",
                "        bash \"$dir/install.sh\" --prefix \"$HOME/.local/bin\"",
                "        status=$?",
                "    else",
                "        status=$?",
                "        printf '\\n没能下载官方安装脚本（curl 退出码 %s）。检查网络后再点一次「在终端中安装」。\\n' \"$status\"",
                "    fi",
                "    rm -rf \"$dir\"",
                "fi",
                "printf '\\n'",
                "if [ \"$status\" -eq 0 ]; then",
                "    printf '已装好。Jarvis 会自动发现它；没有的话重新打开设置页「清理」看一眼。\\n'",
                "else",
                "    printf '安装没有完成（退出码 %s）。上面是原始输出。\\n' \"$status\"",
                "fi",
                "printf '\\n按回车关闭。'",
                "read -r _",
                "exit \"$status\""
              ]
            }
          ]
        },
        "files": {
          "read": [
            "~/Library/Logs/mole/operations.log"
          ]
        },
        "contributes": {
          "services": [
            {
              "point": "junkClean.engine",
              "id": "mole",
              "title": "深度清理（Mole）",
              "subtitle": "改走你装好的 mo clean：覆盖浏览器、开发工具、云盘与已卸载应用残留等更多类别",
              "notes": [
                "系统级那一段需要管理员权限：Mole 不会要密码，没有现成的 sudo 会话时直接跳过",
                "白名单 ~/.config/mole/whitelist 与 Jarvis 清理共用，写进去的路径两边都不删",
                "永久删除，不经过废纸篓；Mole 还会清空废纸篓",
                "读 Mole 的操作日志，逐项显示正在删什么；读不到时只看 mo 的输出",
                "mo 在 Jarvis 里运行，继承 Jarvis 的完全磁盘访问权限"
              ],
              "preferences": [
                {
                  "key": "command",
                  "type": "text",
                  "title": "mo 命令",
                  "description": "填 mo 自动在 Homebrew、~/.local/bin 与 Nix 的位置里找；也可以填可执行文件的完整路径",
                  "default": "mo",
                  "placeholder": "mo",
                  "monospaced": true
                }
              ]
            }
          ]
        },
        "inbox": false
      },
