{
  "name": "@fusionseek/jarvis-extension-sdk",
  "version": "2.14.0",
  "description": "Jarvis 扩展 SDK 2：按域组织的 manifest 类型、工具箱 / 窗口 / 指令 / 服务 / 菜单栏的入口（含清理引擎与项目引擎两个扩展点）、声明式 UI 节点、宿主能力接口（含 Git 操作域、Android 操作域、常驻进程与系统代理、增强模式（TUN）、悬浮球读数、浏览器当前页与挑文件）、OCR 段落合并与 JavaScriptCore 桥。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fusionseek/jarvis-extensions"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
