{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.fusionseek.ai/schemas/extension.v2.schema.json",
  "title": "Jarvis extension manifest v2",
  "description": "每个扩展目录里的 extension.json。v2 按「域」组织：扩展在 contributes 里声明它入驻工具箱、窗口、指令、设置、服务、Git 中的哪几个；悬浮球不是可入驻的域。跨字段规则（能力 ⇔ 声明对象、落点 ⇔ 域、键不重）由 scripts/validate.mjs 与宿主各查一遍，见 docs/03-manifest.md。",
  "type": "object",
  "required": [
    "manifestVersion",
    "id",
    "version",
    "name",
    "symbol",
    "description",
    "author",
    "main",
    "sdk",
    "minimumJarvisVersion",
    "capabilities",
    "contributes",
    "inbox"
  ],
  "properties": {
    "manifestVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "description": "扩展标识，同时是目录名。小写字母开头，只允许小写字母、数字与单个连字符。",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 40
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "name": {
      "type": "string",
      "description": "扩展的名字：工具箱那一行、窗口标签、面板 header、设置页那块面板的标题。header 留给标题的宽度只有 144pt。",
      "minLength": 1,
      "maxLength": 12
    },
    "symbol": {
      "type": "string",
      "description": "SF Symbol 名：工具箱那一行、header 徽标、商店卡片。不接受 emoji、图片或自绘路径。",
      "pattern": "^[A-Za-z0-9.-]+$",
      "minLength": 1,
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "description": "扩展商店卡片上的说明。回答「它替我做什么」，不写营销语。",
      "minLength": 8,
      "maxLength": 240
    },
    "author": {
      "$ref": "#/$defs/author"
    },
    "repository": {
      "type": "string",
      "description": "源码地址；省略时指向本仓库里的扩展目录。",
      "pattern": "^https://[^\\s]+$",
      "maxLength": 256
    },
    "main": {
      "type": "string",
      "description": "构建产物：相对扩展目录的单文件 JS bundle，必须提交进仓库。",
      "pattern": "^dist/[A-Za-z0-9._-]+\\.js$"
    },
    "sdk": {
      "type": "string",
      "description": "依赖的 SDK 主版本区间，形如 ^2.0.0。宿主只兼容同一主版本。",
      "pattern": "^\\^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "minimumJarvisVersion": {
      "$ref": "#/$defs/semver"
    },
    "capabilities": {
      "type": "array",
      "description": "要向用户申请的宿主能力。空数组表示这个扩展只用隐式能力（存储、偏好、纯函数工具）。",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/capabilityRequest"
      }
    },
    "network": {
      "$ref": "#/$defs/network"
    },
    "process": {
      "$ref": "#/$defs/process"
    },
    "files": {
      "$ref": "#/$defs/files"
    },
    "git": {
      "$ref": "#/$defs/git"
    },
    "contributes": {
      "$ref": "#/$defs/contributes"
    },
    "inbox": {
      "description": "往 Inbox 投不投消息、弹不弹系统横幅。false = 都不；对象 = 两条通路各开不开。",
      "oneOf": [
        {
          "const": false
        },
        {
          "$ref": "#/$defs/inboxParticipation"
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 40
    },
    "author": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$",
          "maxLength": 256
        },
        "github": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$"
        }
      },
      "additionalProperties": false
    },
    "capabilityID": {
      "type": "string",
      "description": "能力目录见 docs/06-capabilities.md。只列宿主真的做得到的；隐式能力（panel.* / storage.* / preferences.* / text.* / time.* / color.* / window.open / service.* / host.* / log）不在这里声明。git.* 三项是 Git 操作域：声明任一项都要入驻 Git 域（contributes.git），git.hosting.write 还要逐字写出 git.mutations。android.* 两项是 Android 操作域：宿主经自己的 adb 跑它写死的那几条命令（列设备、列应用、读应用名与图标），扩展只给设备序列号与包名、不给参数；android.tools.open 把一个包名交给内置的「APK 扫描」「数据导出」。apps.read 读这台 Mac 装了哪些应用（名字、Bundle ID、位置、分类、最近打开 / 添加时刻）：宿主自己扫三处应用目录，扩展不给路径；打开、删除应用由用户在 Jarvis 全局搜索里点，扩展做不了。 process.daemon 是常驻进程（manifest process.daemons 逐字声明可执行文件与一组参数；宿主托管它的生死、只放行发往它自己控制口的本机请求），system.proxy 把系统代理指向本机 127.0.0.1 的一个端口（要求这个扩展此刻有一个在跑的常驻进程或 TUN 内核；都没了宿主自动还原）——jarvis-mac specs/20261028-091917-proxy-extension-menubar-daemon。SDK 2.10（jarvis-mac specs/20261028-111714-proxy-tun-orb-traffic-page-rules）：network.tunnel 以管理员身份运行 sing-box 接管整机网络（TUN 增强模式，要 manifest process.tunnel；第一次打开时用户输一次管理员密码装上 Jarvis 的网络助手，配置过宿主的守卫、TUN 段由宿主填）；browser.activeTab 读前台（或最近一次激活的）浏览器当前标签的地址与标题（系统「自动化」授权）；files.pick 让用户在宿主画的打开面板里挑一个文件交给扩展读（只拿到文件名与正文，拿不到路径）。 SDK 2.11（jarvis-mac specs/20261029-225323-menubar-manager-p1）：menuBar.pointer 感知指针进出菜单栏那一条、在那里点击与滚动（只报菜单栏带里的事，指针在别处的位置读不到）；menuBarExtras.read 读系统菜单栏上有哪些图标——任何应用的，归属、说明、位置（借 Jarvis 的辅助功能权限）。",
      "enum": [
        "clipboard.read",
        "clipboard.write",
        "quickTransfer.status",
        "quickTransfer.control",
        "quickTransfer.send",
        "screenshot.capture",
        "notifications.post",
        "inbox.post",
        "network.https",
        "system.openURL",
        "ocr.recognize",
        "speech.speak",
        "hotkeys.register",
        "process.run",
        "files.read",
        "terminal.run",
        "process.daemon",
        "system.proxy",
        "network.tunnel",
        "browser.activeTab",
        "files.pick",
        "git.repository.read",
        "git.hosting.read",
        "git.hosting.write",
        "android.apps.read",
        "android.tools.open",
        "apps.read",
        "menuBar.pointer",
        "menuBarExtras.read"
      ]
    },
    "capabilityRequest": {
      "type": "object",
      "required": [
        "id",
        "reason"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/capabilityID"
        },
        "reason": {
          "type": "string",
          "description": "授权屏里那一行的第二句：这个扩展拿它做什么。写给用户看，不写给审核看。",
          "minLength": 4,
          "maxLength": 60
        }
      },
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "description": "声明了 network.https 时必填：允许访问的主机。hosts 是写死的白名单；preferenceHosts 点名本扩展的 urlList 偏好——用户在设置里亲手填的地址，它们的主机在请求那一刻放行（订阅地址这类作者写 manifest 时不知道在哪的地址）。两者至少一项。宿主只放行 HTTPS，且只认完全相等的主机名。",
      "properties": {
        "hosts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$",
            "maxLength": 253
          }
        },
        "preferenceHosts": {
          "type": "array",
          "description": "本扩展声明的 urlList 偏好的 key（1–4 个）。设置页的控件由宿主画，值只可能来自用户亲手输入；页面里的输入框扩展自己就能填，宿主分不出是谁写的，所以不认。",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9]*$",
            "maxLength": 32
          }
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "hosts"
          ]
        },
        {
          "required": [
            "preferenceHosts"
          ]
        }
      ]
    },
    "process": {
      "type": "object",
      "description": "受限执行。executables 配 process.run，terminal 配 terminal.run，daemons 配 process.daemon，tunnel 配 network.tunnel（SDK 2.10）。宿主只放行这里逐字写出的可执行文件、参数组合与脚本。",
      "minProperties": 1,
      "properties": {
        "executables": {
          "type": "array",
          "description": "至多 16 个：一个格式化扩展要包一整套工具链（clang-format、swift-format、ktfmt、ruff、shfmt、prettier……），每个工具一项；每一项仍逐字声明参数。",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/executable"
          }
        },
        "terminal": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/terminalScript"
          }
        },
        "daemons": {
          "type": "array",
          "description": "常驻进程（SDK 2.9），至多 2 个。",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/daemon"
          }
        },
        "tunnel": {
          "type": "object",
          "description": "TUN 增强模式（SDK 2.10，配 network.tunnel）：宿主的网络助手以管理员身份运行哪一个内核。本期只认 sing-box——宿主的配置守卫只懂它。跑的是安装那一刻从用户的 sing-box 拷进 root 目录、校验过哈希的副本，不是用户目录里那一份。",
          "required": [
            "executable"
          ],
          "properties": {
            "executable": {
              "const": "sing-box"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "executable": {
      "type": "object",
      "required": [
        "name",
        "arguments"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "可执行文件的名字（不带路径）。宿主在 Homebrew、~/.local/bin、~/bin 与 Nix 的固定位置里找；用户填的绝对路径，文件名必须等于它。",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "stdin": {
          "type": "boolean",
          "description": "SDK 2.7：允许 process.run 经标准输入交给它一段文字（≤ 1 MiB）。省略 = 不允许，stdin 接空设备。只给本职就是从 stdin 读数据的工具（格式化工具）；解释器（sh、python、node）不得声明——那等于把参数当脚本。授权屏与商店详情把声明了它的可执行文件逐个念出来。",
          "default": false
        },
        "arguments": {
          "type": "array",
          "description": "允许的参数组合（1–16 组）。一次调用的参数必须与其中某一组逐项相等——不支持通配，读 manifest 就知道它会跑什么。一个工具认好几种语法时（prettier 的 Markdown / JS / TS / CSS…）每种一组。",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[^\\s;&|`$<>]+$"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "terminalScript": {
      "type": "object",
      "required": [
        "id",
        "title",
        "script"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "description": "授权屏与按钮上的名字，例如「安装 Mole」。",
          "minLength": 1,
          "maxLength": 16
        },
        "script": {
          "type": "array",
          "description": "在终端里逐字执行的 sh 脚本，一行一个元素。扩展只能按 id 点名，不能传内容。",
          "minItems": 1,
          "maxItems": 80,
          "items": {
            "type": "string",
            "maxLength": 240
          }
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "object",
      "description": "声明了 files.read 时必填：允许读的文件。绝对路径或 ~ 开头；不接受目录、通配与 ..。",
      "required": [
        "read"
      ],
      "properties": {
        "read": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^~?/[^*?]*[^*?/]$",
            "maxLength": 256
          }
        }
      },
      "additionalProperties": false
    },
    "git": {
      "type": "object",
      "description": "Git 操作域的声明。声明了 git.hosting.write 时必填：宿主只执行这里逐字写出的 GraphQL 变更（按顶层字段名比对），查询不受它限制。授权屏与商店详情逐字列给用户。",
      "required": [
        "mutations"
      ],
      "properties": {
        "mutations": {
          "type": "array",
          "description": "GraphQL 变更的顶层字段名，例如 updateProjectV2ItemFieldValue。只写代码里真的会发的那几个。",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[_A-Za-z][_0-9A-Za-z]*$",
            "maxLength": 80
          }
        }
      },
      "additionalProperties": false
    },
    "contributes": {
      "type": "object",
      "description": "扩展入驻的域。至少要有工具箱、窗口、指令、服务、菜单栏之一——只有设置的扩展没有入口；Git 域也不是入口，它只决定扩展在 Git 里出现在哪、碰得到哪些托管服务；悬浮球那一层（orb，SDK 2.10）同样不是入口。",
      "anyOf": [
        {
          "required": [
            "toolbox"
          ]
        },
        {
          "required": [
            "window"
          ]
        },
        {
          "required": [
            "commands"
          ]
        },
        {
          "required": [
            "services"
          ]
        },
        {
          "required": [
            "menuBar"
          ]
        }
      ],
      "properties": {
        "toolbox": {
          "$ref": "#/$defs/toolbox"
        },
        "window": {
          "$ref": "#/$defs/window"
        },
        "menuBar": {
          "$ref": "#/$defs/menuBar"
        },
        "orb": {
          "$ref": "#/$defs/orb"
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "settings": {
          "$ref": "#/$defs/settings"
        },
        "services": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/service"
          }
        },
        "git": {
          "$ref": "#/$defs/gitContribution"
        }
      },
      "additionalProperties": false
    },
    "keywords": {
      "type": "array",
      "description": "搜索时额外认的词。只装名字与说明里没有的词。",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 24
      }
    },
    "toolbox": {
      "type": "object",
      "description": "工具箱域：目录里一行，点开是面板里 400×520 的一屏。",
      "required": [
        "subtitle"
      ],
      "properties": {
        "subtitle": {
          "type": "string",
          "description": "列表排布下那一行说明。",
          "minLength": 1,
          "maxLength": 22
        },
        "keywords": {
          "$ref": "#/$defs/keywords"
        }
      },
      "additionalProperties": false
    },
    "window": {
      "type": "object",
      "description": "窗口域：在 Jarvis 工作区窗口里开一枚标签。入口是 presentation: window 的命令、全局搜索与页面里的 jarvis.window.open()。",
      "required": [
        "subtitle"
      ],
      "properties": {
        "subtitle": {
          "type": "string",
          "description": "全局搜索那一行与标签副标题。",
          "minLength": 1,
          "maxLength": 40
        },
        "keywords": {
          "$ref": "#/$defs/keywords"
        }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "description": "指令域里的一条命令：/ 指令、全局快捷键、页面按钮都落到 defineExtension({ commands }) 里同 id 的处理函数。",
      "required": [
        "id",
        "title",
        "presentation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12
        },
        "description": {
          "type": "string",
          "maxLength": 60
        },
        "slash": {
          "$ref": "#/$defs/slash"
        },
        "hotkey": {
          "type": "string",
          "description": "全局快捷键默认值：修饰键按 ⌃⌥⇧⌘ 顺序 + 一个主键；至少含 ⌃、⌥、⌘ 之一。要声明 hotkeys.register。",
          "pattern": "^(?=.*[⌃⌥⌘])⌃?⌥?⇧?⌘?(?:[A-Z0-9]|F[1-9]|F1[0-2]|[-=\\[\\];',./])$"
        },
        "presentation": {
          "enum": [
            "toolbox",
            "window",
            "popover",
            "silent"
          ],
          "description": "toolbox = 展开面板到它的页面（要工具箱域）；window = 在工作区开它的标签（要窗口域）；popover = 原地结果弹窗（要工具箱域）；silent = 后台会话里跑，不碰任何界面。"
        }
      },
      "additionalProperties": false
    },
    "slash": {
      "type": "object",
      "description": "在全局搜索与速记输入框的 / 下拉里出现。关键词与内置指令撞了，这条不加载。",
      "required": [
        "keyword"
      ],
      "properties": {
        "keyword": {
          "type": "string",
          "description": "/ 下拉里显示的那一个。",
          "pattern": "^[a-z][a-z0-9-]{1,19}$"
        },
        "aliases": {
          "type": "array",
          "description": "也认的词，可以是中文。",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[^\\s/]{1,12}$"
          }
        },
        "argument": {
          "type": "string",
          "description": "参数提示；有它 = 这条指令要参数。",
          "minLength": 1,
          "maxLength": 24
        },
        "scopes": {
          "type": "array",
          "description": "出现在哪：launcher = 全局搜索（全局启动条与默认页搜索栏），memo = 速记输入框。省略 = 两处都要。",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "launcher",
              "memo"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "description": "设置域：设置页「扩展」区段里属于它的那块面板，控件由宿主画。",
      "required": [
        "preferences"
      ],
      "properties": {
        "preferences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/preference"
          }
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "description": "服务域：实现宿主开放的一个扩展点。没有独立界面；它的设置画在扩展点指定的那个内置区段里。",
      "required": [
        "point",
        "id",
        "title",
        "subtitle"
      ],
      "properties": {
        "point": {
          "enum": [
            "junkClean.engine",
            "project.engine",
            "launcher.apps",
            "code.format",
            "code.highlight"
          ],
          "description": "扩展点。junkClean.engine = 清理引擎：设置「清理」里出现它的开关与设置，开着时晃球、/clean 与工具箱清理都走它。project.engine = 项目引擎：Jarvis「项目」（需求 / 迭代 / 缺陷）的数据来源，设置画在「Git」里；它的托管服务读写要配 Git 域与 Git 操作域的能力。launcher.apps = 全局搜索的应用目录：装了它，全局搜索的结果里才有本机应用、输入 app 空格才进应用网格；它交出怎么分组、组里先后、搜索结果里出不出与出几条（方法 catalog），网格由 Jarvis 画；设置画在「全局搜索」里，读应用要声明 apps.read。code.format（SDK 2.7）= Git 的代码格式化：Jarvis 按文件名认出语言，文件 diff 页里工作区那一份文件出「格式化」；方法 describe 报认得哪几种语言、此刻能不能用，format 交回格式化之后的全文，预览与写回由 Jarvis 做、由用户点；设置画在「Git」里。code.highlight（SDK 2.8）= Git 的代码高亮：Jarvis 按文件名认出语言，文件 diff 页与 Blame 的代码交给它切记号（方法 describe 报认得哪几种语言，highlight 交回记号的起点、长度与种类），颜色由 Jarvis 按种类定；设置画在「Git」里。"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "description": "在那个内置能力里的名字，例如「深度清理（Mole）」。",
          "minLength": 1,
          "maxLength": 16
        },
        "subtitle": {
          "type": "string",
          "description": "一句话说它比内置的多做了什么。",
          "minLength": 1,
          "maxLength": 80
        },
        "notes": {
          "type": "array",
          "description": "须知：画在设置区段与工具页的范围说明里。",
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "preferences": {
          "type": "array",
          "description": "这个服务自己的设置，画在扩展点指定的区段里。键与 contributes.settings 的键共用一个命名空间，不能重。",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/preference"
          }
        }
      },
      "additionalProperties": false
    },
    "gitContribution": {
      "type": "object",
      "description": "Git 域：入驻 Git 的哪些托管服务、在那里是什么。没入驻的扩展碰不到 Git；Git 操作域的能力只对这里列出的服务放行。",
      "required": [
        "hosting",
        "summary"
      ],
      "properties": {
        "hosting": {
          "type": "array",
          "description": "托管服务标识（例如 github），与 Jarvis Git 服务的服务标识一致。只声明一个时 jarvis.git.hosting.* 可以省略 hosting；声明了多个就每次显式传。",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "summary": {
          "type": "string",
          "description": "商店「装上之后」那一行：在 Git 里出现在哪，例如「Git 设置「Project 关联」与 Projects 分组」。",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "additionalProperties": false
    },
    "preferenceBase": {
      "type": "object",
      "required": [
        "key",
        "type",
        "title"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$",
          "maxLength": 32
        },
        "type": {
          "enum": [
            "toggle",
            "text",
            "number",
            "select",
            "multiselect",
            "secret",
            "directory",
            "urlList",
            "executable"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "description": {
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "option": {
      "type": "object",
      "required": [
        "value",
        "title"
      ],
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,32}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        }
      },
      "additionalProperties": false
    },
    "preference": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/preferenceBase"
        },
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "toggle"
                },
                "default": {
                  "type": "boolean"
                }
              },
              "required": [
                "default"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "text"
                },
                "default": {
                  "type": "string",
                  "maxLength": 200
                },
                "placeholder": {
                  "type": "string",
                  "maxLength": 40
                },
                "maxLength": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 200
                },
                "monospaced": {
                  "type": "boolean",
                  "description": "路径、命令这类机器串用等宽字。"
                }
              },
              "required": [
                "default"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "number"
                },
                "default": {
                  "type": "number"
                },
                "minimum": {
                  "type": "number"
                },
                "maximum": {
                  "type": "number"
                },
                "step": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "default",
                "minimum",
                "maximum"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "select"
                },
                "default": {
                  "type": "string"
                },
                "options": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 8,
                  "items": {
                    "$ref": "#/$defs/option"
                  }
                }
              },
              "required": [
                "default",
                "options"
              ]
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "multiselect"
                },
                "default": {
                  "type": "array",
                  "maxItems": 8,
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                "options": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 8,
                  "items": {
                    "$ref": "#/$defs/option"
                  }
                }
              },
              "required": [
                "default",
                "options"
              ]
            },
            {
              "type": "object",
              "description": "机密：宿主存 Keychain、设置页遮罩显示、只交给这个扩展、不进日志。没有默认值。",
              "properties": {
                "type": {
                  "const": "secret"
                },
                "placeholder": {
                  "type": "string",
                  "maxLength": 40
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "const": "directory"
                }
              }
            },
            {
              "type": "object",
              "description": "一列地址（SDK 2.9）：每条必须是带主机名的 https:// 地址，至多 maxItems 条（默认 10）。secret 省略 = true：整列进 Keychain（订阅地址里的 token 就是密码），只能经 preferences.get 单独读。被 network.preferenceHosts 点名时，这些地址的主机放行给 net.fetch。没有默认值。",
              "properties": {
                "type": {
                  "const": "urlList"
                },
                "maxItems": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "secret": {
                  "type": "boolean"
                },
                "placeholder": {
                  "type": "string",
                  "maxLength": 40
                }
              }
            },
            {
              "type": "object",
              "description": "一个外部程序的位置（Jarvis 3.2.8 起）：设置页由宿主画成与内置工具路径同构的一行——生效路径与来源（自动发现 / 自定义路径）、状态徽标、「选择」「清除」，没找到时「在终端中安装」。值是字符串：空串 = 按名字在固定位置里自动查找，绝对路径 = 用户选的那一份（文件名必须等于 executable）。没有默认值（隐式为空串）、没有占位——路径只能经「选择」挑，不能手打。",
              "properties": {
                "type": {
                  "const": "executable"
                },
                "executable": {
                  "type": "string",
                  "description": "这一项指的是哪个外部程序：必须是本扩展 process.executables[].name、process.daemons[].executable 或 process.tunnel.executable 之一。",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                },
                "install": {
                  "description": "没找到时「在终端中安装」跑哪一段：本扩展 process.terminal[].id。省略 = 只有「选择」。",
                  "$ref": "#/$defs/identifier"
                }
              },
              "required": [
                "executable"
              ]
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "inboxParticipation": {
      "type": "object",
      "required": [
        "messages",
        "notifications"
      ],
      "properties": {
        "messages": {
          "type": "boolean",
          "description": "往 Inbox 投消息。为 true 时必须声明 inbox.post。"
        },
        "notifications": {
          "type": "boolean",
          "description": "弹系统横幅。为 true 时必须声明 notifications.post。"
        }
      },
      "additionalProperties": false
    },
    "daemon": {
      "type": "object",
      "description": "一个常驻进程：生死归宿主（停止只在扩展 stop、停用 / 卸载 / 更新、Jarvis 退出时），不归任何 JS 会话。以用户身份运行、不经 shell、stdin 接空设备。",
      "required": [
        "id",
        "executable",
        "arguments"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "executable": {
          "type": "string",
          "description": "可执行文件名（不带路径），定位规则与 process.executables[].name 相同。",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "arguments": {
          "type": "array",
          "description": "一组固定参数，逐字。只认两个占位符且必须独占一个参数：{config}（宿主写下的配置文件绝对路径）、{workdir}（这个常驻进程的工作目录）；至少用其中一个——宿主靠它在崩溃后认出自己留下的孤儿进程。运行时扩展一个参数都传不进来。",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^\\s;&|`$<>]+$"
          }
        },
        "config": {
          "type": "object",
          "description": "声明了它，daemon.start 就必须带配置正文（≤ 4 MiB），宿主写到 {workdir}/<fileName>（0600），停止后删掉。",
          "required": [
            "fileName"
          ],
          "properties": {
            "fileName": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            }
          },
          "additionalProperties": false
        },
        "reload": {
          "description": "SDK 2.10：声明了它，daemon.reload 就能换配置不断进程——宿主重写同一个配置文件，再发这个信号（本期只认 SIGHUP）。没声明 = daemon.reload 一律拒绝。",
          "enum": [
            "SIGHUP"
          ]
        }
      },
      "additionalProperties": false
    },
    "menuBar": {
      "type": "object",
      "description": "菜单栏域（SDK 2.9）：系统菜单栏上属于这个扩展的一枚图标与它的菜单。宿主用 NSStatusItem + NSMenu 画，扩展经 jarvis.menuBar.update 推一份声明式模型；代码跑在后台会话。宿主在菜单末尾固定追加「打开」「设置」两项。用户可以在 设置 · 扩展 里关掉它。 SDK 2.11（jarvis-mac specs/20261029-225323-menubar-manager-p1 N-1）：items 声明 1–4 枚状态项，各有自己的模型与菜单（menuBar.update 的 statusItem 点名改哪一枚）；第一枚在最右，按声明顺序往左排。不写 items 等于一枚 main。",
      "required": [
        "title",
        "symbol"
      ],
      "properties": {
        "title": {
          "type": "string",
          "description": "设置页与 VoiceOver 里这枚图标的名字。",
          "minLength": 1,
          "maxLength": 20
        },
        "symbol": {
          "type": "string",
          "description": "还没收到模型时的图标（SF Symbol）。",
          "pattern": "^[A-Za-z0-9.-]+$",
          "minLength": 1,
          "maxLength": 64
        },
        "preferences": {
          "type": "array",
          "description": "这枚图标自己的设置（jarvis-mac specs/20261028-130540-proxy-walkthrough-fixes W-1）：contributes.settings.preferences 里几项的 key，宿主把它们从通用偏好列表里拿出来，画在设置页「在菜单栏显示」那一行下面（图标关着时置灰）。每个 key 必须在 settings.preferences 里声明过。",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9]*$",
            "maxLength": 32
          }
        },
        "items": {
          "type": "array",
          "description": "这个扩展在菜单栏上的状态项（SDK 2.11）：1–4 枚、id 不重复。宿主只认 id、名字与图标，不知道它拿来做什么——开关、读数、分组用的空白都一样。不写 = 一枚 id 为 main、名字与图标取上面的 title / symbol。",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "symbol"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "menuBar.update 的 statusItem、事件里的 statusItem 都用它。",
                "pattern": "^[a-z][a-z0-9-]{0,31}$"
              },
              "title": {
                "type": "string",
                "description": "设置页与 VoiceOver 里这一枚的名字（空白时 VoiceOver 也读它）。",
                "minLength": 1,
                "maxLength": 20
              },
              "symbol": {
                "type": "string",
                "description": "还没收到模型、或扩展的会话收掉之后画的那枚 SF Symbol。",
                "pattern": "^[A-Za-z0-9.-]+$",
                "minLength": 1,
                "maxLength": 64
              },
              "placement": {
                "enum": [
                  "leading",
                  "trailing"
                ],
                "description": "第一次出现在菜单栏哪一端（SDK 2.11）：leading（默认，系统的做法）是所有图标的最左端——图标一多就落在刘海下面看不见；trailing 是最右端、紧挨控制中心与时钟，同一个扩展的几枚按声明顺序从右往左排。用户 ⌘ 拖过之后以系统记住的位置为准。"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "orb": {
      "type": "object",
      "description": "悬浮球那一层（SDK 2.10）：扩展经 jarvis.orb.update 推一份读数（本期只有 traffic：有效上下行速率与最近一个窗口的成败连接数），宿主画在收起态的悬浮球上——外圈一道成败环，球心空着时两行速率。画法宿主定；5 秒没有更新自动撤掉；用户可以在 设置 · 扩展 里关掉「在悬浮球上显示」。它不是入口域：只有它的扩展不合法。",
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "description": "设置页那个开关与 VoiceOver 里这一层的名字，例如「代理流量」。",
          "minLength": 1,
          "maxLength": 20
        }
      },
      "additionalProperties": false
    }
  }
}
